{
  "name": "silicon-dm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4315 --strictPort",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "npm run check && vite build && node scripts/build.mjs",
    "start": "node dist/server/node.js",
    "format": "prettier --write src server vite.config.ts scripts"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "dependencies": {
    "solid-js": "1.9.15",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14"
  }
}
