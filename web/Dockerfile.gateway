FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm typecheck && pnpm lint && pnpm test && NEXT_OUTPUT=standalone pnpm build
FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=4315
WORKDIR /app
RUN groupadd --gid 10001 silicon && useradd --uid 10001 --gid silicon --no-create-home silicon
COPY --from=build --chown=silicon:silicon /app/.next/standalone ./
COPY --from=build --chown=silicon:silicon /app/.next/static ./.next/static
COPY --from=build --chown=silicon:silicon /app/public ./public
USER silicon
EXPOSE 4315
CMD ["node", "server.js"]
