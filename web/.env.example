# Silicon DM's website environment. Copy to .env.local for `pnpm dev` (never commit it) and fill in the blanks; on Vercel set
# the same names in Project Settings → Environment Variables. Every value is read at request time and checked at boot:
# a missing or malformed one stops the server with an exact message (lib/server/env.ts).

# This app's Silicon Accounts app_id (defaults to lib/app.config.ts appId).
APP_ID=dm
# The app secret (sa_app_…), shown once when the app was created in Silicon Apps. Server only.
APP_SECRET=
# The public origin of Silicon Accounts (the hosted sign-in, and the issuer of every token).
ACCOUNTS_URL=http://localhost:9590
# Optional: where this server reaches the Accounts API (defaults to ACCOUNTS_URL).
ACCOUNTS_API_URL=http://127.0.0.1:9589
# This app's own service: /api/* and apiFetch() call it with Authorization: Bearer <access token>.
APP_API_URL=http://127.0.0.1:4121
# At least 32 random bytes; seals the session cookies. Generate one with: openssl rand -base64 48
SESSION_SECRET=
# This site's origin. Register {PUBLIC_URL}/auth/callback in the app's redirect_uris at Silicon Accounts.
PUBLIC_URL=http://127.0.0.1:4120
# Optional, comma separated: more origins images may load from (the local stack's mock Iris serves profile photos).
EXTRA_IMG_ORIGINS=http://127.0.0.1:9594
# Optional, comma separated: more origins allowed to send state-changing requests (another domain of this site).
EXTRA_ORIGINS=

# Optional: Silicon Briefcase's API origin. The website saves a Carbon's files and voice notes there, in apps/dm/ of the
# Carbon's own Briefcase, as DM acting for them (User verification proofs); messages carry the links. https:// only
# (plain http only for a stand-in on this machine, such as the chat stack's on 4541). Unset: uploads are off, the +
# menu and the microphone say so, and links, GIFs and dictation still work.
BRIEFCASE_API_URL=
# Optional: the largest file this website takes, in bytes, for a limit of your own (1073741824 is 1 GiB). A file over
# it is refused before any byte is sent, with the limit in words. Unset, the only limit is Silicon Briefcase's, 5 TiB a
# file: files pass through this website to Briefcase without being held on disk or in memory.
UPLOADS_MAX_BYTES=

# Durable browser sessions: required in production. Use a persistent private path on one host, or DynamoDB.
# REFRESH_STATE_PATH=/var/lib/app/browser-sessions.sqlite
# REFRESH_STATE_TABLE=silicon-app-browser-sessions
# REFRESH_STATE_REGION=us-east-2
# REFRESH_STATE_ROLE_ARN=arn:aws:iam::ACCOUNT:role/APP-browser-sessions
