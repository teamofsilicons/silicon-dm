# Local defaults. Keep credentials out of this file and all VITE_* values.
DM_API_ORIGIN=https://backend.dm.teamofsilicons.com
DM_WEB_ORIGIN=http://127.0.0.1:4315
DM_FRONTEND_ORIGIN=http://127.0.0.1:4315
DM_WEB_APP_ID=tos>dm
# Optional private persistent gateway state directory (absolute path).
# DM_WEB_STATE_DIR=/private/path/silicon-dm-web
# Set only for split frontend/gateway hosting; this is a public build setting.
# VITE_DM_GATEWAY_ORIGIN=https://gateway.dm.teamofsilicons.com

# Ting cookie host, never the separate backend hostname. No secrets.
DM_TING_BROWSER_ORIGIN=https://ting.teamofsilicons.com
# Static Vercel CSP must allow that same host.
# VITE_DM_TING_BROWSER_ORIGIN=https://ting.teamofsilicons.com
