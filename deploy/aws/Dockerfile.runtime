# syntax=docker/dockerfile:1.7
ARG BACKEND_IMAGE
FROM debian:bookworm-slim AS certificates
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && curl --fail --silent --show-error --location --retry 3 \
       https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
       --output /aws-rds-global-bundle.pem \
    && chmod 0644 /aws-rds-global-bundle.pem
FROM ${BACKEND_IMAGE}
COPY --from=certificates /aws-rds-global-bundle.pem /opt/silicon-dm/aws-rds-global-bundle.pem
USER root
RUN install -d -m 0700 -o 10001 -g 10001 /var/lib/silicon-dm/telemetry
# Fargate copies this ownership into the task's private writable bind mount.
VOLUME ["/var/lib/silicon-dm/telemetry"]
USER 10001:10001
