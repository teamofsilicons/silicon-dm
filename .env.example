DM_ENVIRONMENT=development
# Local convention for this repo: the service on 4121 (the web on 4120).
DM_BIND_ADDR=127.0.0.1:4121
DM_PUBLIC_BASE_URL=http://127.0.0.1:4121/api/v1
DM_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/silicon_dm
# Production requires exactly one sslmode=verify-full query parameter.
DM_DATABASE_MAX_CONNECTIONS=16
DM_DATABASE_MIN_CONNECTIONS=1
DM_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
DM_DATABASE_STATEMENT_TIMEOUT_SECONDS=10
DM_REQUEST_TIMEOUT_SECONDS=15
DM_SHUTDOWN_TIMEOUT_SECONDS=30
DM_MAX_HTTP_BODY_BYTES=134217728
DM_LOG_FILTER=info,silicon_dm=debug

# Silicon Accounts. ACCOUNTS_URL is the public origin and exactly the `iss` of its tokens;
# ACCOUNTS_API_URL (optional) is where DM calls it server to server. Plain http is accepted
# only for this machine (localhost, *.localhost, loopback addresses).
ACCOUNTS_URL=https://accounts.teamofsilicons.com
# ACCOUNTS_API_URL=https://accounts.teamofsilicons.com
DM_APP_ID=dm
DM_APP_SECRET=replace-with-the-dm-app-secret
# The app webhook signing secret (whsec_…); the webhook URL is https://<api host>/webhook/.
DM_ACCOUNTS_WEBHOOK_SECRET=whsec_replace-me
DM_ACCOUNTS_REQUEST_TIMEOUT_SECONDS=5
# 32 random bytes, base64 (openssl rand -base64 32). Keys the sync-cursor MAC and the
# at-rest encryption of stored proofs. Keep it stable and backed up.
DM_DATA_KEY=replace-with-base64-32-random-bytes
# Apps whose User verification proofs DM accepts, per scope (empty = none). Scopes:
# dm.conversations.read, dm.messages.read, dm.messages.write, dm.receipts.write, dm.drafts.write
# DM_PROOF_ISSUERS=dm.conversations.read=interface,dm.messages.read=interface,dm.messages.write=interface

# Ting delivery is off unless DM_TING_URL is set; clients then sync with GET /api/v1/sync.
# DM_TING_URL=https://backend.ting.teamofsilicons.com
DM_TING_REQUEST_TIMEOUT_SECONDS=15

DM_GIPHY_API_BASE_URL=https://api.giphy.com/v1/gifs
DM_GIPHY_API_KEY=replace-me
DM_PROVIDER_REQUEST_TIMEOUT_SECONDS=10

DM_HEARTBEAT_INTERVAL_SECONDS=30
DM_HEARTBEAT_TIMEOUT_SECONDS=120
DM_WS_OUTBOUND_CAPACITY=256
DM_PRESENCE_ACTIVITY_TTL_SECONDS=10
DM_DELIVERY_BATCH_SIZE=100
DM_DELIVERY_POLL_INTERVAL_MILLISECONDS=250
DM_DELIVERY_LEASE_SECONDS=30
DM_DELIVERY_MAX_ATTEMPTS=20
DM_DELIVERY_MAX_RETRY_SECONDS=300
DM_TRENDING_GIF_CACHE_SECONDS=300

# Optional: Postmark for `dm report` notifications (outside production, reports are stored
# and marked simulated when this is unset).
# DM_POSTMARK_SERVER_TOKEN=replace-me
