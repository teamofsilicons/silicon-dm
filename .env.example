DM_ENVIRONMENT=development
DM_BIND_ADDR=127.0.0.1:8080
DM_PUBLIC_BASE_URL=http://127.0.0.1:8080/api/v1
DM_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/silicon_dm
# Production requires exactly one sslmode=verify-full query parameter.
DM_DATABASE_MAX_CONNECTIONS=16
DM_DATABASE_MIN_CONNECTIONS=1
DM_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
DM_DATABASE_STATEMENT_TIMEOUT_SECONDS=10
DM_REQUEST_TIMEOUT_SECONDS=15
DM_SHUTDOWN_TIMEOUT_SECONDS=30
DM_MAX_HTTP_BODY_BYTES=134217728
DM_LOG_FILTER=info,silicon_dm=debug

DM_IAM_BASE_URL=http://127.0.0.1:8081
DM_IAM_APP_ID=silicon-dm
DM_IAM_APP_SECRET=replace-me
DM_IAM_REQUEST_TIMEOUT_SECONDS=5

DM_BRIEFCASE_BASE_URL=http://127.0.0.1:8082/api/v1
DM_BRIEFCASE_IAM_AUDIENCE=silicon-briefcase
DM_GIPHY_API_BASE_URL=https://api.giphy.com/v1/gifs
DM_GIPHY_API_KEY=replace-me
DM_PROVIDER_REQUEST_TIMEOUT_SECONDS=10

DM_HEARTBEAT_INTERVAL_SECONDS=30
DM_HEARTBEAT_TIMEOUT_SECONDS=120
DM_WS_OUTBOUND_CAPACITY=256
DM_PRESENCE_ACTIVITY_TTL_SECONDS=10
DM_DELIVERY_BATCH_SIZE=100
DM_DELIVERY_POLL_INTERVAL_MILLISECONDS=250
DM_DELIVERY_LEASE_SECONDS=30
DM_DELIVERY_MAX_ATTEMPTS=20
DM_DELIVERY_MAX_RETRY_SECONDS=300
DM_TRENDING_GIF_CACHE_SECONDS=300
